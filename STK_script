local function getPlayerRole(player)
    local team = player.Team
    if team then
        local teamName = string.lower(team.Name)
        if string.find(teamName, "killer") or string.find(teamName, "murderer") then return "Killer" end
        if string.find(teamName, "survivor") or string.find(teamName, "innocent") then return "Survivor" end
    end
    local roleAttr = player:GetAttribute("Role") or player:GetAttribute("IsKiller")
    if roleAttr == true or roleAttr == "Killer" then return "Killer" end
    if roleAttr == false or roleAttr == "Survivor" then return "Survivor" end
    local char = player.Character
    if char then
        local charAttr = char:GetAttribute("Role") or char:GetAttribute("IsKiller")
        if charAttr == true or charAttr == "Killer" then return "Killer" end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local humAttr = humanoid:GetAttribute("IsKiller")
            if humAttr then return "Killer" end
        end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            local toolName = string.lower(tool.Name)
            if string.find(toolName, "knife") or string.find(toolName, "weapon")
                or string.find(toolName, "sword") or string.find(toolName, "blade")
                or string.find(toolName, "cleaver") or string.find(toolName, "axe") then
                return "Killer"
            end
        end
    end
    return "Survivor"
end

function getKiller()
