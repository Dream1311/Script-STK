    return nil, nil
end

local function isLockerOccupied(locker)
    if not locker or not locker.Parent then return false end
    if locker.Transparency and locker.Transparency >= 0.95 then return false end

    for _, descendant in ipairs(locker:GetDescendants()) do
        if descendant:IsA("Sound") then
            if descendant.Name == "LockerOpen" and descendant.IsPlaying then
                return true
            end
        end
    end

    local lockerPos = locker.Position
    if not lockerPos then return false end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local playerPos = root.Position
        if not playerPos then continue end
        if playerPos.X ~= playerPos.X or playerPos.Y ~= playerPos.Y or playerPos.Z ~= playerPos.Z then
            continue
        end

        local distance = (playerPos - lockerPos).Magnitude
        if distance < LockerESP.CheckRadius then
            return true
        end
    end

    return false
end

