				if check.Name == "_Lobby" then
					inLobby = true
					break
				end
				if check == workspace then break end
				check = check.Parent
			end

			if inLobby and AutoFarm.SkipLobby then
				task.wait(1)
				continue
			end

			local killerChar, killerRoot = getKiller()
