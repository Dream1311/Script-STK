				if AutoFarm.Mode == "Teleport" then
					farmTeleportToSpawnPoint(point)
				else
					farmTweenToSpawnPoint(point)
				end
			end

			currentSpawnIndex = currentSpawnIndex + 1
			if currentSpawnIndex > #farmSpawnPoints then
				currentSpawnIndex = 1
				farmCycle = farmCycle + 1
				scanAllSpawnPoints()
			end
		end
	end
end)

