task.spawn(function()
	while not unloaded do
		task.wait(AntiKiller.CheckInterval)
		if not AntiKiller.Enabled then continue end

		local killerChar, killerRoot = getKiller()
		if not killerChar or not killerRoot then continue end

		local char = LocalPlayer.Character
		if not char then continue end
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		local killerPos = killerRoot.Position
		local playerPos = root.Position
		local distance = (playerPos - killerPos).Magnitude

		if distance < AntiKiller.SafeDistance then
			local bestSpawn = nil
			local bestDistance = -math.huge
			
			for _, item in ipairs(farmSpawnPoints) do
				if not isLootStillValid(item) then continue end
				local distToKiller = (item.Position - killerPos).Magnitude
				local distToPlayer = (item.Position - playerPos).Magnitude
				
				if distToKiller > AntiKiller.SafeDistance * 1.5 and distToPlayer < 800 then
					if distToKiller > bestDistance then
						bestDistance = distToKiller
						bestSpawn = item
					end
				end
			end
			
			if bestSpawn then
				root.CFrame = CFrame.new(bestSpawn.Position + Vector3.new(0, 3, 0))
			else
				local direction = (playerPos - killerPos)
				if direction.Magnitude < 0.01 then
					direction = Vector3.new(math.random(-1, 1), 0, math.random(-1, 1))
				end
				direction = direction.Unit
				
				local targetPos = killerPos + direction * (AntiKiller.SafeDistance * 2)
				targetPos = Vector3.new(
					math.clamp(targetPos.X, -2000, 2000),
					math.clamp(targetPos.Y, 5, 500),
					math.clamp(targetPos.Z, -2000, 2000)
				)
				
				root.CFrame = CFrame.new(targetPos)
			end
		end
	end
end)

local function findEscapeTarget()
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if not descendant.Parent then continue end
		if not descendant:IsA("BasePart") then continue end
		if isInLobby(descendant) then continue end

		local hasExits = false
		local hasExitGateway = false
		local hasTrigger = false

		local check = descendant
		while check do
			if check.Name == "Exits" then hasExits = true end
			if check.Name == "ExitGateway" then hasExitGateway = true end
			if check.Name == "Trigger" then hasTrigger = true end
			if check == workspace then break end
			check = check.Parent
		end

		if not (hasExits and hasExitGateway and hasTrigger) then continue end

		local hasExitIcon = false
		for _, child in ipairs(descendant:GetDescendants()) do
			if child.Name == "ExitIcon" then
				hasExitIcon = true
				break
			end
		end

		local isVisible = descendant.Transparency < 0.9
		local canEnter = not descendant.CanCollide
		local hasPrompt = descendant:FindFirstChildOfClass("ProximityPrompt") ~= nil

		if hasExitIcon or (isVisible and canEnter) or hasPrompt then
			return descendant
		end
	end
	return nil
end

task.spawn(function()
	while not unloaded do
		task.wait(AutoEscape.CheckInterval)
		if not AutoEscape.Enabled then continue end
		if escaped then continue end

		local char = LocalPlayer.Character
		if not char then continue end
		
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end
		
		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		
		local inLobby = false
		local check = char
		while check do
			if check.Name == "_Lobby" then
				inLobby = true
				break
			end
			if check == workspace then break end
			check = check.Parent
		end
		
		if inLobby then
			escaped = false
			continue
		end

		local escapePart = findEscapeTarget()
		if not escapePart then continue end
		
		local distance = (root.Position - escapePart.Position).Magnitude
		if distance < 10 then
			escaped = true
			Rayfield:Notify({
				Title = "Auto Escape",
				Content = "Ты сбежал! Телепорт отключён",
				Duration = 3,
			})
			continue
		end
		
		root.CFrame = CFrame.new(escapePart.Position + Vector3.new(0, 3, 0))
	end
end)

