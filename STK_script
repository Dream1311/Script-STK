local function findChildOfClass(instance, className)
	for _, child in ipairs(instance:GetChildren()) do
		if child.ClassName == className then return child end
	end
	return nil
end

local function isInLobby(instance)
	local current = instance
	while current do
		if current.Name == "_Lobby" then return true end
		if current == workspace then break end
		current = current.Parent
	end
	return false
end

local function isPlayerCharacter(instance)
	local model = instance:FindFirstAncestorOfClass("Model")
	if not model then return false end
	if not findChildOfClass(model, "Humanoid") then return false end
	return Players:GetPlayerFromCharacter(model) ~= nil
end

local function isLootStillValid(target)
	if not target or not target.Parent then return false end
	if not target:IsA("BasePart") then return false end
	local current = target.Parent
	local inContainer = false
	while current do
		if current.Name == "DebrisFolder" then return false end
		if current.Name == "LootSpawns" or current.Name == "Collectables" then
			inContainer = true
			break
		end
		if current == workspace then break end
		current = current.Parent
	end
	if not inContainer then return false end
	local pos = target.Position
	if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
	return true
end

local function findPromptRecursive(instance)
	local prompt = instance:FindFirstChildOfClass("ProximityPrompt")
	if prompt then return prompt end
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") then
			return descendant
		end
	end
	return nil
end

local function getPlayerRole(player)
	local team = player.Team
	if team then
		local teamName = string.lower(team.Name)
		if string.find(teamName, "killer") or string.find(teamName, "murderer") then return "Killer" end
		if string.find(teamName, "survivor") or string.find(teamName, "innocent") then return "Survivor" end
	end
	local roleAttr = player:GetAttribute("Role") or player:GetAttribute("IsKiller")
	if roleAttr == true or roleAttr == "Killer" then return "Killer" end
	if roleAttr == false or roleAttr == "Survivor" then return "Survivor" end
	local char = player.Character
	if char then
		local charAttr = char:GetAttribute("Role") or char:GetAttribute("IsKiller")
		if charAttr == true or charAttr == "Killer" then return "Killer" end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local humAttr = humanoid:GetAttribute("IsKiller")
			if humAttr then return "Killer" end
		end
		local tool = char:FindFirstChildOfClass("Tool")
		if tool then
			local toolName = string.lower(tool.Name)
			if string.find(toolName, "knife") or string.find(toolName, "weapon")
				or string.find(toolName, "sword") or string.find(toolName, "blade")
				or string.find(toolName, "cleaver") or string.find(toolName, "axe") then
				return "Killer"
			end
		end
	end
	return "Survivor"
end

function getKiller()
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		if getPlayerRole(player) == "Killer" then
			local char = player.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				if root then return char, root end
			end
		end
	end
	return nil, nil
end

local function isLockerOccupied(locker)
	if not locker or not locker.Parent then return false end
	if locker.Transparency and locker.Transparency >= 0.95 then return false end

	for _, descendant in ipairs(locker:GetDescendants()) do
		if descendant:IsA("Sound") then
			if descendant.Name == "LockerOpen" and descendant.IsPlaying then
				return true
			end
		end
	end

	local lockerPos = locker.Position
	if not lockerPos then return false end

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char then continue end

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		local playerPos = root.Position
		if not playerPos then continue end
		if playerPos.X ~= playerPos.X or playerPos.Y ~= playerPos.Y or playerPos.Z ~= playerPos.Z then
			continue
		end

		local distance = (playerPos - lockerPos).Magnitude
		if distance < LockerESP.CheckRadius then
			return true
		end
	end

	return false
end

local function createLockerESP(locker)
	if activeLockerESP[locker] then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "LockerESP_Highlight"
	highlight.Adornee = locker
	highlight.FillColor = LockerESP.EmptyColor
	highlight.OutlineColor = LockerESP.EmptyColor
	highlight.FillTransparency = 0.7
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = locker

	activeLockerESP[locker] = {
		highlight = highlight,
	}
end

local function removeLockerESP(locker)
	local data = activeLockerESP[locker]
	if not data then return end
	if data.highlight then data.highlight:Destroy() end
	activeLockerESP[locker] = nil
end

local function clearAllLockerESP()
	for locker, _ in pairs(activeLockerESP) do removeLockerESP(locker) end
end

local function scanForLockers()
	if unloaded then return end
	if not LockerESP.Enabled then return end

	for _, descendant in ipairs(workspace:GetDescendants()) do
		if not descendant.Parent then continue end
		if not descendant:IsA("BasePart") then continue end
		if isInLobby(descendant) then continue end

		local isLockerPart = false
		local check = descendant
		while check do
			if check.Name == "Lockers" then
				isLockerPart = true
				break
			end
			if check == workspace then break end
			check = check.Parent
		end

		if isLockerPart then
			if not activeLockerESP[descendant] then
				createLockerESP(descendant)
			end
		end
	end
end

local function updateLockerESP()
	if not LockerESP.Enabled then return end
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local playerPos = root.Position

	for locker, data in pairs(activeLockerESP) do
		if not locker or not locker.Parent then
			removeLockerESP(locker)
			continue
		end

		local distance = (playerPos - locker.Position).Magnitude
		local visible = distance <= LockerESP.MaxDistance

		if data.highlight then data.highlight.Enabled = visible end

		if visible then
			local occupied = isLockerOccupied(locker)

			if occupied then
				data.highlight.FillColor = LockerESP.OccupiedColor
				data.highlight.OutlineColor = LockerESP.OccupiedColor
			else
				data.highlight.FillColor = LockerESP.EmptyColor
				data.highlight.OutlineColor = LockerESP.EmptyColor
			end
		end
	end
end

