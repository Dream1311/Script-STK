local function refreshPlayerStyles()
	for _, data in pairs(activePlayerESP) do
		local color = (data.role == "Killer") and PlayerESP.KillerColor or PlayerESP.SurvivorColor
		if data.highlight then
			data.highlight.FillColor = color
			data.highlight.OutlineColor = color
			data.highlight.DepthMode = PlayerESP.SeeThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		end
		if data.stroke then data.stroke.Color = color end
		if data.nameLabel then
			data.nameLabel.TextColor3 = color
			data.nameLabel.Visible = PlayerESP.ShowName
		end
		if data.roleLabel then data.roleLabel.TextColor3 = color end
		if data.distLabel then data.distLabel.Visible = PlayerESP.ShowDistance end
		if data.billboard then
			data.billboard.MaxDistance = PlayerESP.MaxDistance
			data.billboard.AlwaysOnTop = PlayerESP.SeeThroughWalls
		end
	end
end

local function updatePlayerESP()
	if not PlayerESP.Enabled then return end
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local playerPos = root.Position

	for player, data in pairs(activePlayerESP) do
		if not player or not player.Parent then removePlayerESP(player) continue end
		if not data.char or not data.char.Parent then removePlayerESP(player) continue end

		local pRoot = data.char:FindFirstChild("HumanoidRootPart")
		if not pRoot then removePlayerESP(player) continue end

		local distance = (playerPos - pRoot.Position).Magnitude
		local visible = PlayerESP.Enabled and distance <= PlayerESP.MaxDistance

		if data.highlight then data.highlight.Enabled = visible end
		if data.billboard then data.billboard.Enabled = visible end

		local newRole = getPlayerRole(player)
		if newRole ~= data.role then
			data.role = newRole
			local newColor = (newRole == "Killer") and PlayerESP.KillerColor or PlayerESP.SurvivorColor
			if data.highlight then
				data.highlight.FillColor = newColor
				data.highlight.OutlineColor = newColor
			end
			if data.stroke then data.stroke.Color = newColor end
			if data.nameLabel then data.nameLabel.TextColor3 = newColor end
			if data.roleLabel then
				data.roleLabel.Text = "[" .. newRole .. "]"
				data.roleLabel.TextColor3 = newColor
			end
		end

		if data.distLabel then
			data.distLabel.Text = string.format("%d studs", math.floor(distance))
		end
	end
end

local function scanAllSpawnPoints()
	if unloaded then return end

	local newList = {}
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if not descendant.Parent then continue end
		if descendant.Name == "LootSpawns" or descendant.Name == "Collectables" then
			for _, item in ipairs(descendant:GetChildren()) do
				if not item.Parent then continue end
				if item.Parent ~= descendant then continue end
				if not item:IsA("BasePart") then continue end
				if isPlayerCharacter(item) then continue end
				if not isLootStillValid(item) then continue end

				table.insert(newList, item)
			end
		end
	end

	farmSpawnPoints = newList
end

local function tweenToPoint(point, callback)
	if not point or not point.Parent then
		if callback then callback(false) end
		return
	end
	local char = LocalPlayer.Character
	if not char then
		if callback then callback(false) end
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		if callback then callback(false) end
		return
	end

	local targetPos = point.Position + Vector3.new(0, 3, 0)
	local distance = (root.Position - targetPos).Magnitude
	local duration = distance / (AutoFarm.TweenSpeed * 100)

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	activeTween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
	activeTween:Play()

	activeTween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			if callback then callback(true) end
		else
			if callback then callback(false) end
		end
	end)
end

local function farmTeleportToSpawnPoint(point)
	if not point or not point.Parent then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	local oldPos = root.Position
	local targetPos = point.Position + Vector3.new(0, 3, 0)
	root.CFrame = CFrame.new(targetPos)

	task.wait(0.15)

	local newPos = root.Position
	if (newPos - oldPos).Magnitude < 5 then
		root.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
		task.wait(0.1)
		return false
	end

	local prompt = findPromptRecursive(point)
	if not prompt then
		local parent = point.Parent
		if parent then
			prompt = findPromptRecursive(parent)
		end
	end

	if prompt then
		pcall(function()
			prompt.HoldDuration = 0
			prompt.RequiresLineOfSight = false
		end)
		pcall(function()
			fireproximityprompt(prompt)
		end)
		task.wait(0.15)
	end

	return true
end

local function farmTweenToSpawnPoint(point)
	if not point or not point.Parent then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return false end

	local oldPos = root.Position
	local targetPos = point.Position + Vector3.new(0, 3, 0)
	local distance = (oldPos - targetPos).Magnitude
	local duration = distance / (AutoFarm.TweenSpeed * 100)

	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
	activeTween = tween
	tween:Play()
	tween.Completed:Wait()
	activeTween = nil

	task.wait(0.05)

	local prompt = findPromptRecursive(point)
	if not prompt then
		local parent = point.Parent
		if parent then
			prompt = findPromptRecursive(parent)
		end
	end

	if prompt then
		pcall(function()
			prompt.HoldDuration = 0
			prompt.RequiresLineOfSight = false
		end)
		pcall(function()
			fireproximityprompt(prompt)
		end)
		task.wait(0.1)
	end

	return true
end

function killAllPlayers()
	local char = LocalPlayer.Character
	if not char then return 0 end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return 0 end

	local myPos = root.Position
	local count = 0

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local pChar = player.Character
		if not pChar then continue end
		local pRoot = pChar:FindFirstChild("HumanoidRootPart")
		if not pRoot then continue end

		pRoot.CFrame = CFrame.new(myPos + Vector3.new(math.random(-5, 5), 2, math.random(-5, 5)))
		count = count + 1
	end

	return count
end

