    })

    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
        Parent = page,
    })

    local tabData = {
        Button = tabBtn,
        Label = label,
        Indicator = indicator,
        Page = page,
        Name = name,
    }

    tabBtn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tabData then
            tween(tabBtn, { BackgroundColor3 = Theme.SurfaceAlt })
        end
