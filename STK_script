local function farmTeleportToSpawnPoint(point)
    if not point or not point.Parent then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local oldPos = root.Position
    local targetPos = point.Position + Vector3.new(0, 3, 0)
    root.CFrame = CFrame.new(targetPos)

    task.wait(0.15)

    local newPos = root.Position
    if (newPos - oldPos).Magnitude < 5 then
        root.CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))
        task.wait(0.1)
        return false
    end

    local prompt = findPromptRecursive(point)
    if not prompt then
        local parent = point.Parent
        if parent then
            prompt = findPromptRecursive(parent)
        end
    end

    if prompt then
        pcall(function()
            prompt.HoldDuration = 0
            prompt.RequiresLineOfSight = false
        end)
        pcall(function()
            fireproximityprompt(prompt)
        end)
        task.wait(0.15)
    end

    return true
end

local function farmTweenToSpawnPoint(point)
    if not point or not point.Parent then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local targetPos = point.Position + Vector3.new(0, 3, 0)
    local distance = (root.Position - targetPos).Magnitude
    local duration = distance / (AutoFarm.TweenSpeed * 100)

    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tw = TweenService:Create(root, tweenInfo, {CFrame = CFrame.new(targetPos)})
    activeTween = tw
    tw:Play()
    tw.Completed:Wait()
    activeTween = nil

    task.wait(0.05)

    local prompt = findPromptRecursive(point)
    if not prompt then
        local parent = point.Parent
        if parent then
            prompt = findPromptRecursive(parent)
        end
    end

    if prompt then
        pcall(function()
            prompt.HoldDuration = 0
            prompt.RequiresLineOfSight = false
        end)
        pcall(function()
            fireproximityprompt(prompt)
        end)
        task.wait(0.1)
    end

    return true
end

